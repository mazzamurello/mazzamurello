{
  "name": "mazzamurello-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "generate": "openapi-typescript ../../specs/contracts/openapi.yaml -o src/api/schema.d.ts",
    "build": "openapi-typescript ../../specs/contracts/openapi.yaml -o src/api/schema.d.ts && tsc --noEmit && vite build",
    "typecheck": "openapi-typescript ../../specs/contracts/openapi.yaml -o src/api/schema.d.ts && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "5.104.5",
    "i18next": "26.5.3",
    "katex": "0.19.0",
    "lucide-react": "1.60.0",
    "mermaid": "12.2.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
